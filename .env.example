# ── Formulário da palestra (/palestra/) ──────────────────────────────────────
# URL do Apps Script (Web App, termina em /exec) que grava na planilha do Drive
# "Inscrições — Palestra (formulário do site)". Ver scripts/apps-script/inscricoes-palestra.gs.
PUBLIC_PALESTRA_SHEET_ENDPOINT=

# Opcional: endpoint de leads do ramon-hub (CRM), com o token no fim — mesmo valor
# do repo ramonantonio-landing-pages. Vazio = não envia ao CRM.
PUBLIC_LEADS_ENDPOINT=

# Sem nenhum dos dois, o formulário encaminha os dados por WhatsApp.

---
import Base from '../../layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { waLink } from '../../data/site.ts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });

// Posts relacionados (>=1 tag em comum; fallback: mais recentes), no máx. 3
const all = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id);
const related = all
  .map((p) => ({ p, score: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.data.pubDate.valueOf() - a.p.data.pubDate.valueOf())
  .slice(0, 3)
  .map((x) => x.p);

// FAQ derivado dos H2 do corpo que são perguntas
const QUESTION_RE = /\?\s*$/;
const START_RE = /^(o que|quem|quando|como|qual|quais|por que|é possível|preciso|posso)\b/i;
const lines = (post.body ?? '').split('\n');
const faq: { q: string; a: string }[] = [];
for (let i = 0; i < lines.length; i++) {
  const m = lines[i].match(/^##\s+(.*)$/);
  if (!m) continue;
  const q = m[1].trim();
  if (!(QUESTION_RE.test(q) || START_RE.test(q))) continue;
  const buf: string[] = [];
  for (let j = i + 1; j < lines.length && !/^#{1,6}\s/.test(lines[j]); j++) buf.push(lines[j]);
  const a = buf
    .map((l) => l.replace(/^\s*[-*>]\s+/, '').trim())  // remove leading bullet/quote markers
    .join(' ')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')            // [texto](url) -> texto
    .replace(/[*_`#]/g, '')                              // inline markdown, mas mantém hífens
    .replace(/\s+/g, ' ')
    .trim();
  if (a.length > 40) faq.push({ q: q.endsWith('?') ? q : q + '?', a });
}

const abs = (p: string) => new URL(p, Astro.site).href;
const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  image: abs(post.data.image ?? '/images/og-default.jpg'),
  publisher: {
    '@type': 'Organization',
    name: 'Ramon Antonio Advogados',
    logo: { '@type': 'ImageObject', url: abs('/images/logo.jpeg') },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': abs(`/blog/${post.id}/`) },
};
const faqPage = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Base
  title={`${post.data.title} — Blog`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  author={post.data.author}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  {faqPage && <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />}
  <article class="post section">
    <div class="container post__container">
      <a href="/blog" class="post__back">← Voltar ao blog</a>
      <header class="post__header">
        <div class="post__meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          <span>•</span><span>{post.data.author}</span>
        </div>
        <h1>{post.data.title}</h1>
        {post.data.tags.length > 0 && (
          <ul class="post__tags">{post.data.tags.map((t) => <li>#{t}</li>)}</ul>
        )}
      </header>

      {post.data.image && <img class="post__cover" src={post.data.image} alt="" />}

      <div class="post__body">
        <Content />
      </div>

      {related.length > 0 && (
        <section class="post__related">
          <h2>Leia também</h2>
          <ul>
            {related.map((r) => (
              <li><a href={`/blog/${r.id}`}>{r.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <aside class="post__cta">
        <h3>Precisa de ajuda com o seu caso?</h3>
        <p>Nossa equipe analisa o seu histórico e indica o melhor caminho.</p>
        <a href={waLink} class="btn btn--primary" target="_blank" rel="noopener">Falar no WhatsApp</a>
        <a href="/#areas" class="post__cta-link">Ver áreas de atuação →</a>
      </aside>
    </div>
  </article>
</Base>

<style>
  .post__container { max-width: 760px; }
  .post__back { display: inline-block; margin-bottom: 1.5rem; font-weight: 600; font-size: .9rem; }
  .post__meta { display: flex; gap: .5rem; align-items: center; color: var(--bronze-lt); font-size: .88rem; text-transform: uppercase; letter-spacing: .04em; }
  .post__header h1 { margin: .7rem 0 1rem; }
  .post__tags { display: flex; flex-wrap: wrap; gap: .5rem; }
  .post__tags li { background: var(--cream); color: var(--bronze-dk); padding: .25rem .7rem; border-radius: 999px; font-size: .8rem; }
  .post__cover { width: 100%; border-radius: var(--radius); margin: 1.8rem 0; }

  .post__body { font-size: 1.08rem; line-height: 1.8; color: var(--text); }
  .post__body :global(h2) { margin: 2.2rem 0 .8rem; }
  .post__body :global(h3) { margin: 1.6rem 0 .6rem; }
  .post__body :global(p) { margin-bottom: 1.1rem; }
  .post__body :global(ul), .post__body :global(ol) { margin: 0 0 1.1rem 1.3rem; }
  .post__body :global(ul) { list-style: disc; }
  .post__body :global(ol) { list-style: decimal; }
  .post__body :global(li) { margin-bottom: .4rem; }
  .post__body :global(a) { text-decoration: underline; }
  .post__body :global(blockquote) {
    border-left: 3px solid var(--bronze); background: var(--cream-lt);
    padding: 1rem 1.3rem; margin: 1.4rem 0; border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-soft); font-style: italic;
  }
  .post__body :global(strong) { color: var(--bronze-dk); }

  .post__cta {
    margin-top: 3rem; padding: 2rem; text-align: center;
    background: var(--dark); color: var(--ink); border-radius: var(--radius);
  }
  .post__cta h3 { color: var(--cream); margin-bottom: .5rem; }
  .post__cta p { color: var(--ink-dim); margin-bottom: 1.3rem; }

  .post__related { margin-top: 3rem; border-top: 1px solid var(--cream-dk); padding-top: 1.6rem; }
  .post__related h2 { font-size: 1.3rem; margin-bottom: .9rem; }
  .post__related ul { display: grid; gap: .6rem; }
  .post__related a { font-weight: 600; }
  .post__cta-link { display: inline-block; margin-top: .9rem; color: var(--bronze-pl); font-weight: 600; font-size: .92rem; }
</style>

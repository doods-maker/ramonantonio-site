---
interface Props { texto: string; autor: string; }
const { texto, autor } = Astro.props;
---

<figure class="testimonial">
  <span class="testimonial__quote" aria-hidden="true">&ldquo;</span>
  <blockquote>{texto}</blockquote>
  <figcaption>{autor}</figcaption>
</figure>

<style>
  .testimonial {
    position: relative; background: rgba(35,24,16,.72); backdrop-filter: blur(6px); border: 1px solid var(--dark-3);
    border-radius: 16px; padding: 2.2rem 1.9rem 1.9rem;
    transition: transform .35s var(--ease), border-color .35s ease;
  }
  .testimonial:hover { transform: translateY(-5px); border-color: var(--bronze-dk); }
  .testimonial__quote {
    position: absolute; top: .2rem; left: 1.2rem;
    font-family: var(--font-serif); font-size: 5.5rem; color: var(--bronze-pl); opacity: .45; line-height: 1;
  }
  .testimonial blockquote { color: var(--ink); font-family: var(--font-serif); font-style: italic; font-size: 1.4rem; line-height: 1.35; margin-bottom: 1.2rem; position: relative; z-index: 1; }
  .testimonial figcaption { color: var(--bronze-pl); font-weight: 600; font-size: .92rem; }
</style>

---
import Icon from './Icon.astro';
type Item = string | { texto: string; href: string };
interface Props {
  titulo: string;
  descricao: string;
  icone: string;
  itens?: readonly Item[];
  destaque?: boolean;
}
const { titulo, descricao, icone, itens = [], destaque = false } = Astro.props;
const norm = (i: Item) => (typeof i === 'string' ? { texto: i, href: null } : i);
---

<article class={`area-card${destaque ? ' area-card--destaque' : ''}`}>
  {destaque && <span class="area-card__badge">Nossa especialidade</span>}
  <span class="area-card__icon"><Icon name={icone} size={28} /></span>
  <h3>{titulo}</h3>
  <p>{descricao}</p>
  {itens.length > 0 && (
    <ul class="area-card__list">
      {itens.map((i) => {
        const item = norm(i);
        return (
          <li>
            {item.href
              ? <a class="area-card__link" href={item.href}>{item.texto}<span class="area-card__arrow" aria-hidden="true">→</span></a>
              : item.texto}
          </li>
        );
      })}
    </ul>
  )}
</article>

<style>
  .area-card {
    position: relative; background: #fff; border: 1px solid var(--cream-dk);
    border-radius: var(--radius); padding: 1.9rem; overflow: hidden;
    transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s ease;
  }
  /* Barra de gradiente no topo que cresce no hover (do protótipo) */
  .area-card::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 3px;
    background: linear-gradient(90deg, var(--bronze), var(--bronze-pl));
    transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease);
  }
  .area-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: var(--bronze-pl); }
  .area-card:hover::before { transform: scaleX(1); }
  .area-card--destaque {
    grid-column: 1 / -1; background: var(--dark); border-color: var(--bronze-dk); color: var(--ink);
  }
  .area-card--destaque h3 { color: var(--cream); }
  .area-card--destaque p { color: var(--ink-dim); }
  .area-card__badge {
    position: absolute; top: 1.3rem; right: 1.3rem;
    font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
    color: var(--dark); background: var(--bronze-pl); padding: .3rem .7rem; border-radius: 999px;
  }
  .area-card__icon {
    display: grid; place-items: center; width: 54px; height: 54px; border-radius: 12px;
    background: var(--cream); color: var(--bronze); margin-bottom: 1.2rem;
    transition: transform .35s var(--ease), background .35s ease;
  }
  .area-card:hover .area-card__icon { transform: rotate(-6deg) scale(1.06); }
  .area-card--destaque .area-card__icon { background: var(--dark-3); color: var(--bronze-pl); }
  .area-card h3 { margin-bottom: .6rem; }
  .area-card p { color: var(--text-soft); margin-bottom: 1rem; }
  .area-card__list { display: grid; gap: .45rem; }
  .area-card--destaque .area-card__list { grid-template-columns: repeat(3, 1fr); }
  .area-card__list li { position: relative; padding-left: 1.4rem; font-size: .94rem; }
  .area-card__list li::before {
    content: ''; position: absolute; left: 0; top: .55em;
    width: 7px; height: 7px; border-radius: 50%; background: var(--bronze-pl);
  }
  /* Itens com landing page: link discreto, sóbrio (Prov. OAB 205/2021) */
  /* Sem destaque por padrão; o realce aparece só no hover. */
  .area-card__link {
    color: inherit; text-decoration: none;
    text-decoration-color: var(--bronze-pl); text-underline-offset: 3px; text-decoration-thickness: 1px;
    transition: color .25s ease;
  }
  .area-card__link:hover { color: var(--bronze); text-decoration: underline; }
  .area-card--destaque .area-card__link:hover { color: var(--bronze-pl); }
  .area-card__arrow {
    display: inline-block; margin-left: .3rem; opacity: 0;
    transform: translateX(-4px); transition: opacity .25s ease, transform .25s ease;
  }
  .area-card__link:hover .area-card__arrow { opacity: 1; transform: translateX(0); }
  @media (max-width: 860px) {
    .area-card--destaque { grid-column: span 1; }
    .area-card--destaque .area-card__list { grid-template-columns: 1fr; }
  }
</style>

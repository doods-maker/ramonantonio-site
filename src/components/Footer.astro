---
import { site, mapsLink } from '../data/site.ts';
const ano = 2026; // build estático — atualize ao gerar novo build se desejar
---

<footer class="site-footer">
  <div class="container footer__grid">
    <div>
      <div class="brand__text">
        <strong>{site.nome}</strong>
        <small>{site.nomeCompleto}</small>
      </div>
      <p class="footer__about">{site.slogan} em {site.endereco.cidade}/{site.endereco.uf}.</p>
      <p class="footer__cnpj">CNPJ {site.cnpj}</p>
    </div>

    <div>
      <h4>Navegação</h4>
      <ul>
        <li><a href="/#sobre">Sobre</a></li>
        <li><a href="/#areas">Áreas de Atuação</a></li>
        <li><a href="/#equipe">Equipe</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/#contato">Contato</a></li>
        <li><a href="/rss.xml">RSS do blog</a></li>
      </ul>
    </div>

    <div>
      <h4>Contato</h4>
      <ul>
        <li><a href={mapsLink} target="_blank" rel="noopener">{site.endereco.logradouro}, {site.endereco.bairro}</a></li>
        <li>{site.endereco.cidade}/{site.endereco.uf}</li>
        <li><a href={`tel:+${site.whatsapp.numero}`}>{site.telefone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{site.horario}</li>
      </ul>
    </div>

    <div>
      <h4>Redes</h4>
      <ul>
        <li><a href={site.redes.instagram} target="_blank" rel="noopener">Instagram {site.redes.instagramHandle}</a></li>
        <li><a href={site.redes.facebook} target="_blank" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {ano} {site.nomeCompleto}. Todos os direitos reservados.</p>
    <p class="footer__oab">{site.oab}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--dark); color: var(--ink); padding-block: 3.5rem 1.8rem; }
  .footer__grid { display: grid; grid-template-columns: 1.4fr 1fr 1.4fr 1fr; gap: 2.2rem; }
  .site-footer h4 { color: var(--cream); font-size: 1.05rem; margin-bottom: 1rem; }
  .site-footer .brand__text strong { color: var(--cream); font-size: 1.3rem; }
  .site-footer .brand__text small { color: var(--bronze-pl); }
  .site-footer ul li { padding: .25rem 0; }
  .site-footer a { color: var(--ink-dim); }
  .site-footer a:hover { color: var(--bronze-pl); }
  .footer__about { margin: 1rem 0 .6rem; color: var(--ink-dim); max-width: 34ch; }
  .footer__cnpj { color: var(--ink-ghost); font-size: .85rem; }
  .footer__bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem;
    margin-top: 2.6rem; padding-top: 1.6rem; border-top: 1px solid var(--ink-ghost);
    font-size: .85rem; color: var(--ink-dim);
  }
  @media (max-width: 860px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 1.8rem; }
  }
  @media (max-width: 520px) {
    .footer__grid { grid-template-columns: 1fr; }
  }
</style>

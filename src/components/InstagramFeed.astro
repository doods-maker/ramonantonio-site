---
import { site } from '../data/site.ts';

// Embed do feed do Instagram.
// O Instagram não permite ler o feed sem API/token, então o caminho confiável
// para um site estático é um widget gratuito que gera um <script>/<iframe>:
//   • LightWidget  → https://lightwidget.com  (conecte @ramonantonioadvogados, copie o embed)
//   • Elfsight / SnapWidget também funcionam.
// Cole o código gerado em `public/instagram-embed.html` ou substitua o bloco
// abaixo. Enquanto não houver widget, mostramos um CTA da marca.
---

<section class="ig section section--cream" id="instagram" aria-labelledby="ig-title">
  <div class="container text-center">
    <span class="eyebrow">@ramonantonioadvogados</span>
    <h2 id="ig-title">Acompanhe nosso Instagram</h2>
    <hr class="divider" />
    <p class="lead" style="margin-inline:auto">
      Conteúdo sobre direito previdenciário, novidades do INSS e dicas para garantir
      seus direitos. Siga o escritório e fique por dentro.
    </p>

    <!-- INÍCIO: ponto de inserção do widget de feed (LightWidget/Elfsight/SnapWidget).
         Cole aqui o <script>/<iframe> gerado e remova o .ig__placeholder abaixo. -->
    <div class="ig__placeholder" aria-hidden="true">
      {Array.from({ length: 4 }).map(() => (
        <div class="ig__cell"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></div>
      ))}
    </div>
    <!-- FIM: ponto de inserção do widget -->

    <a href={site.redes.instagram} class="btn btn--primary" target="_blank" rel="noopener" style="margin-top:2rem">
      Seguir no Instagram
    </a>
  </div>
</section>

<style>
  .ig__placeholder {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
    margin-top: 2.4rem;
  }
  .ig__cell {
    aspect-ratio: 1; border-radius: var(--radius);
    background: linear-gradient(150deg, var(--cream-dk), #fff);
    border: 1px dashed var(--bronze-pl); color: var(--bronze-lt);
    display: grid; place-items: center;
  }
  @media (max-width: 720px) { .ig__placeholder { grid-template-columns: repeat(2, 1fr); } }
</style>

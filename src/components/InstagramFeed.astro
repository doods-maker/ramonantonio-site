---
import { site, instagramPosts } from '../data/site.ts';

// Embed OFICIAL do Instagram (sem cadastro/token).
// Os posts vêm de `instagramPosts` em src/data/site.ts. O script embed.js do
// próprio Instagram transforma cada <blockquote> no card real da publicação.
const posts = instagramPosts.filter(Boolean);
const hasPosts = posts.length > 0;
---

<section class="ig section--cream" id="instagram" aria-labelledby="ig-title">
  <div class="container">
    <div class="ig__perfil">
      <a class="ig__avatar" href={site.redes.instagram} target="_blank" rel="noopener" aria-label="Abrir o Instagram do escritório">
        <img src="/images/instagram-perfil.jpg" alt="" width="88" height="88" loading="lazy" />
      </a>
      <div class="ig__info">
        <h2 id="ig-title" class="ig__nome">
          <svg class="ig__logo" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.1" class="ig__ponto" /></svg>
          {site.redes.instagramHandle}
        </h2>
        <p class="ig__bio">{site.redes.instagramBio.map((l) => <span>{l}</span>)}</p>
        <p class="ig__local"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>{site.redes.instagramLocal}</p>
      </div>
      <a href={site.redes.instagram} class="btn btn--primary ig__seguir" target="_blank" rel="noopener">Seguir no Instagram</a>
    </div>

    {hasPosts ? (
      <div class="ig__grid">
        {posts.map((url) => (
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={url}
            data-instgrm-version="14"
          ></blockquote>
        ))}
      </div>
    ) : (
      <div class="ig__placeholder" aria-hidden="true">
        {Array.from({ length: 4 }).map(() => (
          <div class="ig__cell"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></div>
        ))}
      </div>
    )}

  </div>
</section>

{hasPosts && (
  <script is:inline>
    // Só carrega o embed.js (pesado, de terceiro) quando o usuário chega perto
    // da seção do Instagram — economiza bytes/CPU no carregamento inicial.
    (function () {
      var sec = document.getElementById('instagram');
      if (!sec) return;
      var done = false;
      function load() {
        if (done) return;
        done = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.instagram.com/embed.js';
        document.body.appendChild(s);
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          if (entries.some(function (e) { return e.isIntersecting; })) {
            load();
            io.disconnect();
          }
        }, { rootMargin: '400px 0px' });
        io.observe(sec);
      } else {
        load();
      }
    })();
  </script>
)}

<style>
  /* Faixa discreta: cabeçalho numa linha e os posts recortados na altura (fade no pé) */
  .ig { padding-block: clamp(2.6rem, 5vw, 3.6rem); }
  .ig__perfil { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1.4rem; align-items: center; }
  .ig__avatar { position: relative; display: block; width: 88px; height: 88px; border-radius: 50%; padding: 3px;
    background: conic-gradient(from 210deg, var(--bronze-pl), var(--bronze), var(--bronze-lt), var(--bronze-pl)); }
  .ig__avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 3px solid var(--cream); }
  .ig__nome { display: flex; align-items: center; gap: .55rem; font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: .35rem; }
  .ig__logo { width: 26px; height: 26px; flex: none; fill: none; stroke: var(--bronze); stroke-width: 1.7; }
  .ig__logo .ig__ponto { fill: var(--bronze); stroke: none; }
  .ig__bio { display: grid; gap: .1rem; font-size: .95rem; color: var(--text); }
  .ig__bio span:first-child { font-weight: 600; }
  .ig__local { display: flex; align-items: center; gap: .4rem; margin-top: .35rem; font-size: .85rem; color: var(--text-soft); }
  .ig__local svg { width: 15px; height: 15px; fill: none; stroke: var(--bronze); stroke-width: 1.8; }
  @media (max-width: 720px) {
    .ig__perfil { grid-template-columns: auto minmax(0, 1fr); }
    .ig__seguir { grid-column: 1 / -1; justify-self: start; }
    .ig__avatar { width: 72px; height: 72px; }
  }
  .ig__grid {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 1.2rem; margin-top: 1.6rem; max-height: 440px; overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 78%, transparent);
            mask-image: linear-gradient(#000 78%, transparent);
  }
  .ig__grid :global(.instagram-media) {
    margin: 0 !important;
    flex: 0 0 328px !important;
    width: 328px !important;
    min-width: 0 !important;
    max-width: 328px !important;
  }
  .ig__placeholder { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2.4rem; }
  .ig__cell {
    aspect-ratio: 1; border-radius: var(--radius);
    background: linear-gradient(150deg, var(--cream-dk), #fff);
    border: 1px dashed var(--bronze-pl); color: var(--bronze-lt);
    display: grid; place-items: center;
  }
  @media (max-width: 720px) { .ig__placeholder { grid-template-columns: repeat(2, 1fr); } }
</style>

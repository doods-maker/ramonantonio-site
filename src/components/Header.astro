---
import { site, waLink } from '../data/site.ts';

const links = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#areas', label: 'Áreas de Atuação' },
  { href: '/#equipe', label: 'Equipe' },
  { href: '/#depoimentos', label: 'Depoimentos' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contato', label: 'Contato' },
];
---

<header class="site-header" id="topo">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${site.nome} — página inicial`}>
      <img class="brand__logo" src="/images/logo-transparente.png" alt={`${site.nomeCompleto}`} width="120" height="56" />
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <a href={waLink} class="btn btn--primary header__cta" target="_blank" rel="noopener">
      Fale no WhatsApp
    </a>

    <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Navegação mobile" hidden>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href={waLink} class="btn btn--primary" target="_blank" rel="noopener">Fale no WhatsApp</a></li>
    </ul>
  </nav>
</header>

<style>
  /* Fixo e transparente sobre o hero; vira sólido ao rolar (e em páginas sem hero) */
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background .35s ease, box-shadow .35s ease, border-color .35s ease;
  }
  .site-header__inner { display: flex; align-items: center; gap: 1.5rem; min-height: var(--header-h); }
  .brand { display: flex; align-items: center; margin-right: auto; }
  /* Logo transparente (letras claras): o cabeçalho é sempre escuro por baixo */
  .brand__logo { height: 62px; width: auto; transition: height .35s ease; }
  @media (max-width: 520px) { .brand__logo { height: 48px; } }

  .nav ul { display: flex; gap: 1.5rem; align-items: center; }
  .nav a { color: var(--cream); font-size: .92rem; font-weight: 500; opacity: .9; position: relative; padding: .3rem 0; }
  .nav a::after { content: ''; position: absolute; left: 0; bottom: -2px; height: 1.5px; width: 0; background: var(--bronze-pl); transition: width .3s ease; }
  .nav a:hover { color: #fff; opacity: 1; }
  .nav a:hover::after { width: 100%; }

  .header__cta { padding: .62rem 1.3rem; font-size: .88rem; }

  .nav-toggle { display: none; background: none; border: 0; cursor: pointer; padding: .5rem; }
  .nav-toggle span { display: block; width: 26px; height: 2px; background: var(--cream); margin: 5px 0; transition: .25s ease; border-radius: 2px; }

  /* Estado sólido: ao rolar (.scrolled) OU em qualquer página que não seja a home */
  :global(body:not(.is-home)) .site-header,
  .site-header.scrolled {
    background: rgba(27, 20, 15, .92);
    backdrop-filter: blur(12px);
    border-bottom-color: rgba(196, 168, 130, .14);
    box-shadow: 0 6px 24px rgba(0, 0, 0, .25);
  }
  .site-header.scrolled .brand__logo { height: 48px; }

  .mobile-nav { background: var(--dark); border-top: 1px solid var(--dark-3); }
  .mobile-nav ul { display: flex; flex-direction: column; padding: 1rem clamp(1.2rem,4vw,2.4rem) 1.6rem; gap: .25rem; }
  .mobile-nav a:not(.btn) { display: block; padding: .8rem 0; color: var(--ink); font-weight: 500; border-bottom: 1px solid var(--dark-3); }
  .mobile-nav .btn { margin-top: .9rem; justify-content: center; }

  @media (max-width: 980px) {
    .nav, .header__cta { display: none; }
    .nav-toggle { display: block; }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) menu?.removeAttribute('hidden');
    else menu?.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.setAttribute('hidden', '');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );

  // Estado sólido ao rolar para fora do hero (somente na home)
  const header = document.querySelector('.site-header');
  const isHome = document.body.classList.contains('is-home');
  function onScroll() {
    if (!isHome) return;
    // Logo transparente: o fundo escuro entra logo no começo da rolagem (senão o logo cruza o título)
    header?.classList.toggle('scrolled', window.scrollY > 40);
  }
  if (isHome) {
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

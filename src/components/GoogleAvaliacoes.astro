---
// Avaliações do Google (perfil do escritório). Sem `nota` preenchida em site.ts,
// mostra só a faixa com os links (ver avaliações / avaliar) — nada inventado.
import { google, mapsLink } from '../data/site.ts';

const estrelas = (n: number) => '★★★★★'.slice(0, Math.round(n)) + '☆☆☆☆☆'.slice(0, 5 - Math.round(n));
---

<div class="gav">
  <div class="gav__faixa">
    <svg class="gav__g" viewBox="0 0 48 48" aria-hidden="true">
      <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.5z"/>
      <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
      <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
      <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.5z"/>
    </svg>
    <div class="gav__txt">
      {google.nota
        ? <><strong>{google.nota.toLocaleString('pt-BR', { minimumFractionDigits: 1 })} <span class="gav__estrelas" aria-label={`${google.nota} de 5 estrelas`}>{estrelas(google.nota)}</span></strong><span>{google.total} avaliações no Google</span></>
        : <><strong>Avaliações no Google</strong><span>Veja o que os clientes dizem do escritório no perfil do Google.</span></>}
    </div>
    <div class="gav__acoes">
      <a class="btn btn--outline-light" href={mapsLink} target="_blank" rel="noopener">Ver avaliações</a>
      <a class="btn btn--light" href="/avalie">Avaliar o escritório</a>
    </div>
  </div>

  {google.avaliacoes.length > 0 && (
    <ul class="gav__lista">
      {google.avaliacoes.map((a) => (
        <li>
          <span class="gav__estrelas" aria-label={`${a.nota} de 5 estrelas`}>{estrelas(a.nota)}</span>
          <p>“{a.texto}”</p>
          <small>{a.autor} · {a.quando} · Google</small>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .gav { margin-top: 2.4rem; display: grid; gap: 1.2rem; }
  .gav__faixa {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1.2rem; align-items: center;
    padding: 1.2rem 1.4rem; border-radius: 16px; border: 1px solid rgba(196,168,130,.22); background: rgba(35,24,16,.6);
  }
  .gav__g { width: 40px; height: 40px; padding: 7px; border-radius: 50%; background: #fff; box-sizing: content-box; }
  .gav__txt { display: grid; gap: .15rem; }
  .gav__txt strong { font-family: var(--font-serif); font-size: 1.45rem; font-weight: 500; color: #f6ecdc; }
  .gav__txt span { font-size: .9rem; color: rgba(237,224,200,.66); }
  .gav__estrelas { color: #f5b301; letter-spacing: .08em; font-family: var(--font-sans); font-size: 1rem; }
  .gav__acoes { display: flex; flex-wrap: wrap; gap: .6rem; }
  .gav__acoes .btn { padding: .7rem 1.2rem; font-size: .9rem; }
  .gav__lista { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .gav__lista li { padding: 1.3rem; border-radius: 14px; border: 1px solid rgba(196,168,130,.18); display: grid; gap: .5rem; }
  .gav__lista p { color: var(--ink); font-size: .95rem; }
  .gav__lista small { color: rgba(237,224,200,.55); font-size: .8rem; }
  @media (max-width: 860px) {
    .gav__faixa { grid-template-columns: auto minmax(0, 1fr); }
    .gav__acoes { grid-column: 1 / -1; }
    .gav__lista { grid-template-columns: minmax(0, 1fr); }
  }
</style>

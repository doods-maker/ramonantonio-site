---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
}

const {
  title = `${site.nome} — ${site.slogan}`,
  description = `${site.nomeCompleto} em ${site.endereco.cidade}/${site.endereco.uf}. ${site.destaque}`,
  image = '/images/og-default.jpg',
  type = 'website',
  publishedTime,
  author,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const isHome = Astro.url.pathname === '/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: site.nomeCompleto,
  description,
  url: Astro.site?.href,
  telephone: site.telefone,
  areaServed: { '@type': 'State', name: 'Santa Catarina' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.endereco.logradouro,
    addressLocality: site.endereco.cidade,
    addressRegion: site.endereco.uf,
    addressCountry: 'BR',
  },
  sameAs: [site.redes.instagram, site.redes.facebook],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="facebook-domain-verification" content="i1d0ld6hrpin6ylaa4ut94ff6t22jd" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.nome} — Blog`} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Fontes carregadas de forma assíncrona (não bloqueiam a primeira pintura).
        Mesmas famílias/pesos de antes — display=swap mostra o texto na hora. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Marca o estado inicial de "reveal" antes da primeira pintura (evita flash) -->
    <script is:inline>document.documentElement.classList.add('js-reveal');</script>

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={isHome ? 'is-home' : ''}>
    <a href="#main" class="sr-only">Pular para o conteúdo</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <!-- Motion global: reveal ao rolar + contadores animados -->
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1) Marca elementos para animar (sem precisar editar cada seção)
      const groups: [string, boolean][] = [
        ['.section .eyebrow', false],
        ['.section h2', false],
        ['.section .lead', false],
        ['#sobre .sobre__p', false],
        ['.sobre__pillars li', true],
        ['.area-card', true],
        ['.team-card', true],
        ['.testimonial', true],
        ['.ig__cell', true],
        ['.contato__list li', true],
        ['.contato__map', false],
      ];
      groups.forEach(([sel, stagger]) => {
        document.querySelectorAll(sel).forEach((el, i) => {
          if ((el as HTMLElement).closest('.hero')) return; // hero já tem suas próprias classes
          el.classList.add('reveal');
          if (stagger) el.setAttribute('data-d', String((i % 6) + 1));
        });
      });
      document.querySelectorAll('.section .divider').forEach((d) => d.classList.add('grow'));

      // 2) Contadores
      function animateCount(el: HTMLElement) {
        const target = parseFloat(el.getAttribute('data-count') || '0');
        const prefix = el.getAttribute('data-prefix') || '';
        const suffix = el.getAttribute('data-suffix') || '';
        const sep = el.getAttribute('data-sep') === '1';
        const dur = 1500; let start: number | null = null;
        const fmt = (n: number) => sep ? Math.round(n).toLocaleString('pt-BR') : String(Math.round(n));
        function step(ts: number) {
          if (start === null) start = ts;
          const p = Math.min((ts - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = prefix + fmt(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(step);
          else el.textContent = prefix + fmt(target) + suffix;
        }
        requestAnimationFrame(step);
      }

      // 3) Observer
      const revealEls = document.querySelectorAll('.reveal, .divider.grow');
      if (reduce || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('in'));
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          el.textContent = (el.getAttribute('data-prefix') || '') +
            parseFloat(el.getAttribute('data-count') || '0').toLocaleString('pt-BR') +
            (el.getAttribute('data-suffix') || '');
        });
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
              if (e.target.hasAttribute('data-count')) animateCount(e.target as HTMLElement);
            }
          });
        }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
        revealEls.forEach((el) => io.observe(el));
        document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
